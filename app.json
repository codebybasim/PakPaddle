{
  "expo": {
    "name": "pakpadel",
    "slug": "pakpadel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/iTunesArtwork@3x.png",
    "scheme": "pakpadel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/ios/iTunesArtwork@3x.png",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ios/iTunesArtwork@3x.png",
        "backgroundColor": "#01411C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.pakpadel"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080F0A",
          "image": "./assets/ios/iTunesArtwork@3x.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080F0A",
            "image": "./assets/ios/iTunesArtwork@3x.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Barlow-Regular.ttf",
            "./assets/fonts/Barlow-Medium.ttf",
            "./assets/fonts/Barlow-SemiBold.ttf",
            "./assets/fonts/Barlow-Bold.ttf",
            "./assets/fonts/Barlow-ExtraBold.ttf",
            "./assets/fonts/Barlow-Black.ttf",
            "./assets/fonts/Barlow-Light.ttf",
            "./assets/fonts/Barlow-Italic.ttf",
            "./assets/fonts/Barlow-BoldItalic.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PakPadel to use your location to find nearby courts.",
          "locationAlwaysAndWhenInUsePermission": "Allow PakPadel to use your location to find nearby courts.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER-REPLACE-WITH-REVERSED-CLIENT-ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.31.6"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "537dfa45-01c2-4ab7-8dbb-7aa33e62517d"
      }
    }
  }
}
