{
  "expo": {
    "name": "pakpadel",
    "slug": "pakpadel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pakpadel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.pakpadel"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080F0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PakPadel to use your location to find nearby courts.",
          "locationAlwaysAndWhenInUsePermission": "Allow PakPadel to use your location to find nearby courts.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER-REPLACE-WITH-REVERSED-CLIENT-ID"
        }
      ],
      [
  "expo-build-properties",
  {
    "android": {
      "cmakeVersion": "3.31.6"
    }
  }
]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "537dfa45-01c2-4ab7-8dbb-7aa33e62517d"
      }
    }
  }
}
